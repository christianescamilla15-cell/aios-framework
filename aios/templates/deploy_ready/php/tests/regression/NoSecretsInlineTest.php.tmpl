<?php
/**
 * Regression test · {{APP_NAME}} · PHP · credenciales inline NO deben existir.
 * PHPUnit 10 · baseline secrets scanner · bloquea merge si falla.
 */

declare(strict_types=1);

namespace Amx\{{APP_NAME_PASCAL}}\Tests\Regression;

use PHPUnit\Framework\TestCase;
use RecursiveDirectoryIterator;
use RecursiveIteratorIterator;

final class NoSecretsInlineTest extends TestCase
{
    private const SOURCE_EXTS = ['php', 'phtml', 'inc', 'ini', 'yaml', 'yml', 'json', 'env.example'];

    private const FORBIDDEN_PATTERNS = [
        '#\bpassword\s*=\s*[^;"\'\s]{3,}#i'                                      => 'inline-password',
        '#\bpwd\s*=\s*[^;"\'\s]{3,}#i'                                            => 'inline-pwd',
        '#(PASSPHRASE|SFTPPassword|Password|Pwd|ApiSecret|SecretKey|Token|AuthToken)\s*[:=]\s*[\'"][^\'"]{3,}[\'"]#i' => 'credential-literal',
        '#define\s*\(\s*[\'"](DB_PASSWORD|API_KEY|SECRET_KEY)[\'"]\s*,\s*[\'"][^\'"]{3,}[\'"]\s*\)#i' => 'define-credential',
    ];

    private const ALLOWED_PLACEHOLDERS = ['PLACEHOLDER', 'REPLACE_ME', 'xxxxxxxx', '{{', '${', 'getenv(', '$_ENV'];

    private const SKIP_DIRS = ['vendor', 'node_modules', '.git', 'tests', 'build', 'var'];

    public function testNoInlineSecretsInAnySourceFile(): void
    {
        $root = $this->findRepoRoot();
        $violations = [];

        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($root, RecursiveDirectoryIterator::SKIP_DOTS)
        );

        foreach ($iterator as $file) {
            if (!$file->isFile()) continue;
            $path = $file->getPathname();
            if ($this->inSkipDir($path)) continue;
            if (!$this->hasSourceExt($path)) continue;

            $contents = @file_get_contents($path);
            if ($contents === false) continue;
            $lines = preg_split('#\r?\n#', $contents);

            foreach ($lines as $i => $line) {
                foreach (self::ALLOWED_PLACEHOLDERS as $placeholder) {
                    if (stripos($line, $placeholder) !== false) continue 2;
                }
                foreach (self::FORBIDDEN_PATTERNS as $pattern => $ruleId) {
                    if (preg_match($pattern, $line)) {
                        $snippet = substr(trim($line), 0, 120);
                        $violations[] = sprintf('[%s] %s:%d → %s', $ruleId, $path, $i + 1, $snippet);
                        break;
                    }
                }
            }
        }

        $this->assertEmpty(
            $violations,
            sprintf(
                "Secret regression detected · %d violation(s):\n%s\n\nCredenciales deben residir en AWS Secrets Manager · nunca inline.",
                count($violations),
                implode("\n", array_slice($violations, 0, 20))
            )
        );
    }

    private function findRepoRoot(): string
    {
        $cur = __DIR__;
        while ($cur !== dirname($cur)) {
            if (file_exists($cur . '/composer.json')) return $cur;
            $cur = dirname($cur);
        }
        return __DIR__;
    }

    private function inSkipDir(string $path): bool
    {
        foreach (self::SKIP_DIRS as $d) {
            if (str_contains($path, DIRECTORY_SEPARATOR . $d . DIRECTORY_SEPARATOR)) return true;
        }
        return false;
    }

    private function hasSourceExt(string $path): bool
    {
        $ext = strtolower(pathinfo($path, PATHINFO_EXTENSION));
        return in_array($ext, self::SOURCE_EXTS, true);
    }
}
