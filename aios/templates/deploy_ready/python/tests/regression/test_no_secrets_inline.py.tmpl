"""Regression test · {{APP_NAME}} · credenciales inline NO deben existir.
Baseline secrets scanner · bloquea merge si falla."""

import re
from pathlib import Path

import pytest


SOURCE_EXTS = {".py", ".yaml", ".yml", ".json", ".cfg", ".ini", ".env.template"}

# Sincronizado con Mythos policy.py AMX_FORBIDDEN_REGEX
FORBIDDEN_SECRETS = [
    (r"\bpassword\s*=\s*[^;\"'\s]{3,}", "inline-password"),
    (r"\bpwd\s*=\s*[^;\"'\s]{3,}", "inline-pwd"),
    (
        r"[\"\']?(PASSPHRASE|Password|Pwd|ApiSecret|SecretKey|Token|AuthToken)[\"\']?\s*[:=]\s*[\"\'][^\"\']{3,}[\"\']",
        "credential-literal",
    ),
]

ALLOWED_PLACEHOLDERS = ("PLACEHOLDER", "REPLACE_ME", "xxxxxxxx", "{{", "${", "os.environ", "os.getenv")

SKIP_DIRS = ("bin", "obj", "packages", ".vs", "node_modules", "__pycache__", ".venv", "venv", "tests")


def _find_repo_root() -> Path:
    p = Path(__file__).resolve()
    while p.parent != p:
        if (p / "{{APP_ID}}").exists() or (p / "pyproject.toml").exists():
            return p
        p = p.parent
    return Path(__file__).resolve().parents[3]


def _iter_source_files(root: Path):
    for path in root.rglob("*"):
        if not path.is_file():
            continue
        if path.suffix.lower() not in SOURCE_EXTS:
            continue
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        yield path


def test_no_inline_secrets_in_any_source_file():
    root = _find_repo_root()
    violations = []

    for path in _iter_source_files(root):
        try:
            lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
        except OSError:
            continue

        for i, line in enumerate(lines, start=1):
            if any(placeholder in line for placeholder in ALLOWED_PLACEHOLDERS):
                continue
            for pattern, rule_id in FORBIDDEN_SECRETS:
                if re.search(pattern, line, re.IGNORECASE):
                    snippet = line.strip()[:120]
                    violations.append(f"[{rule_id}] {path}:{i} → {snippet}")
                    break

    assert not violations, (
        f"Secret regression detected · {len(violations)} violation(s):\n"
        + "\n".join(violations[:20])
        + "\n\nCredenciales deben residir en AWS Secrets Manager · nunca inline en código/config."
    )
