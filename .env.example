# Variables de entorno que AIOS lee. Ninguna es obligatoria; copia a .env (ignorado por Git) si las usas.

# Clasificador LLM (aios classify / aios iterate --strategies llm_deep_review)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Notificaciones (aios-config.json → notifications.env_override cambia el nombre de esta variable)
AIOS_SLACK_WEBHOOK=

# Tiempo máximo por expresión regular del escáner, en segundos (por omisión 2)
AIOS_REGEX_TIMEOUT_SECONDS=

# Auditoría opcional de llamadas MCP (ver powers/aios-unified/POWER.md)
KCB_SESSION_ID=
KCB_STATE_DIR=
KCB_ACTOR=
