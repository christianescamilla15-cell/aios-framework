// Regression test · {{APP_NAME}} · Java · credenciales inline NO deben existir.
// JUnit 5 · baseline secrets scanner · bloquea merge si falla.

package com.amx.{{APP_ID_SHORT}}.tests.regression;

import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Pattern;
import java.util.stream.Stream;

import static org.junit.jupiter.api.Assertions.assertTrue;

class NoSecretsInlineTest {

    private static final List<String> SOURCE_EXTS = List.of(
        ".java", ".xml", ".properties", ".yaml", ".yml", ".json"
    );

    private static final List<Pattern> FORBIDDEN = List.of(
        Pattern.compile("\\bpassword\\s*=\\s*[^;\"'\\s]{3,}", Pattern.CASE_INSENSITIVE),
        Pattern.compile("\\bpwd\\s*=\\s*[^;\"'\\s]{3,}", Pattern.CASE_INSENSITIVE),
        Pattern.compile("(PASSPHRASE|SFTPPassword|ApiSecret|SecretKey|Token|AuthToken)\\s*[:=]\\s*[\"'][^\"']{3,}[\"']",
            Pattern.CASE_INSENSITIVE)
    );

    private static final List<String> ALLOWED_PLACEHOLDERS = List.of(
        "PLACEHOLDER", "REPLACE_ME", "xxxxxxxx", "{{", "${",
        "System.getenv", "@Value", "@ConfigurationProperties"
    );

    private static final List<String> SKIP_DIRS = List.of(
        "target", "build", ".git", "node_modules", "tests", ".vs", "bin", "obj"
    );

    @Test
    @DisplayName("V-CR-* · no inline secrets in any source file")
    void noInlineSecretsInAnySourceFile() throws IOException {
        Path root = findRepoRoot();
        List<String> violations = new ArrayList<>();

        try (Stream<Path> paths = Files.walk(root)) {
            paths.filter(Files::isRegularFile)
                 .filter(p -> hasSourceExt(p) && !inSkipDir(p))
                 .forEach(p -> scanFile(p, violations));
        }

        assertTrue(violations.isEmpty(),
            "Secret regression detected · " + violations.size() + " violation(s):\n"
            + String.join("\n", violations.subList(0, Math.min(20, violations.size())))
            + "\n\nCredenciales deben residir en AWS Secrets Manager · nunca inline en código/config.");
    }

    private static boolean hasSourceExt(Path p) {
        String s = p.toString().toLowerCase();
        return SOURCE_EXTS.stream().anyMatch(s::endsWith);
    }

    private static boolean inSkipDir(Path p) {
        for (Path part : p) {
            if (SKIP_DIRS.contains(part.toString())) return true;
        }
        return false;
    }

    private static void scanFile(Path path, List<String> violations) {
        try {
            List<String> lines = Files.readAllLines(path, StandardCharsets.UTF_8);
            for (int i = 0; i < lines.size(); i++) {
                String line = lines.get(i);
                if (ALLOWED_PLACEHOLDERS.stream().anyMatch(line::contains)) continue;
                for (Pattern pat : FORBIDDEN) {
                    if (pat.matcher(line).find()) {
                        String snippet = line.trim();
                        if (snippet.length() > 120) snippet = snippet.substring(0, 120) + "...";
                        violations.add(path + ":" + (i + 1) + " → " + snippet);
                        break;
                    }
                }
            }
        } catch (IOException ignored) {}
    }

    private static Path findRepoRoot() {
        Path cur = Paths.get("").toAbsolutePath();
        while (cur.getParent() != null) {
            if (Files.exists(cur.resolve("pom.xml")) || Files.exists(cur.resolve("build.gradle"))) {
                return cur;
            }
            cur = cur.getParent();
        }
        return Paths.get("").toAbsolutePath();
    }
}
