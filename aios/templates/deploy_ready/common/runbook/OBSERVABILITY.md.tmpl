## Structured logging · Serilog config

```csharp
// En Program.cs ({{APP_NAME_PASCAL}}.WorkerService)
Log.Logger = new LoggerConfiguration()
    .MinimumLevel.Information()
    .MinimumLevel.Override("Microsoft", LogEventLevel.Warning)
    .Enrich.FromLogContext()
    .Enrich.WithProperty("Application", "{{APP_ID}}")
    .Enrich.WithProperty("Environment", env)
    .Enrich.WithProperty("RunId", Environment.GetEnvironmentVariable("NOSHOW_RUN_ID"))
    .Filter.ByExcluding(Matching.FromSource("Microsoft.EntityFrameworkCore.Database.Command"))  // reduce noise
    .WriteTo.Console(new Serilog.Formatting.Json.JsonFormatter())  // CloudWatch agent picks up stdout
    .WriteTo.CloudWatchLogs(
        logGroup: $"/amx/{{APP_ID_SHORT}}/{env}",
        createLogGroup: false,
        encrypt: true,
        kmsKeyArn: "arn:aws:kms:us-east-1:ACCOUNT_ID:alias/amx-kms-logs-{{APP_ID_SHORT}}-" + env)
    .Destructure.With(new PiiRedactor())  // Custom destructurer redacts email · PNR · names
    .CreateLogger();
```

## PII Redaction (LFPDPPP compliance)

```csharp
public class PiiRedactor : IDestructuringPolicy
{
    private static readonly Regex EmailRegex = new(@"[\w\.\-]+@[\w\.\-]+\.\w+", RegexOptions.Compiled);
    private static readonly Regex PnrRegex  = new(@"\b[A-Z]{6}\b", RegexOptions.Compiled);
    // Names: redact only in specific keyed properties · too aggressive otherwise

    public bool TryDestructure(object value, ILogEventPropertyValueFactory propertyValueFactory, out LogEventPropertyValue result)
    {
        if (value is string s)
        {
            s = EmailRegex.Replace(s, m => "***@***.***");
            s = PnrRegex.Replace(s, "***PNR***");
            result = new ScalarValue(s);
            return true;
        }
        result = null!;
        return false;
    }
}
```

