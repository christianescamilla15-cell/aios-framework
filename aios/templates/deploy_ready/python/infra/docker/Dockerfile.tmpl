# {{APP_NAME}} · Python · multi-stage build · Alpine
# Hardening AMX: non-root · read-only rootfs (via K8s) · minimal runtime
# Policy AMX v2.0 §10

# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-alpine

# ---- Build stage ---------------------------------------------------------
FROM ${PYTHON_IMAGE} AS build
WORKDIR /build

RUN apk add --no-cache build-base libffi-dev openssl-dev

COPY requirements.txt pyproject.toml* setup.py* ./
RUN pip install --no-cache-dir --prefix=/install --upgrade pip setuptools \
 && pip install --no-cache-dir --prefix=/install -r requirements.txt

COPY src/ src/
RUN pip install --no-cache-dir --prefix=/install .

# ---- Runtime stage -------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime

RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -g 1001 -S app \
 && adduser -u 1001 -S app -G app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    TZ=America/Mexico_City \
    ENV=Production

COPY --from=build /install /usr/local
WORKDIR /app
COPY --chown=app:app src/ .

USER 1001

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=2 \
    CMD ["python", "-m", "{{APP_ID_SHORT}}", "--health-check"]

ENTRYPOINT ["python", "-m", "{{APP_ID_SHORT}}"]

LABEL org.opencontainers.image.title="{{APP_NAME}}" \
      org.opencontainers.image.vendor="Aeroméxico" \
      amx.app.id="{{APP_ID}}" \
      amx.app.tier="{{TIER}}" \
      amx.policy.version="2.0" \
      amx.stack="python3.12-alpine"
