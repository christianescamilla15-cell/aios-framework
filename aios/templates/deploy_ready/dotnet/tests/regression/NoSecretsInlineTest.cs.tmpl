// Regression test · V-CR-02/03/04 · credenciales inline NO deben existir
// Baseline secrets scanner · bloqueante en CI

using System.IO;
using System.Linq;
using System.Text.RegularExpressions;
using Xunit;

namespace {{APP_NAME_PASCAL}}.Tests.Regression;

public class NoSecretsInlineTest
{
    private static readonly string[] SourceExtensions = { ".cs", ".config", ".json", ".xml", ".yaml", ".yml" };

    // Must stay in sync with Mythos policy.py · AMX-SECRET-* rules
    private static readonly (string RuleId, Regex Pattern)[] ForbiddenSecrets =
    {
        ("V-CR-02/03/04 · inline password",
         new Regex(@"\bpassword\s*=\s*[^;""'\s]{3,}", RegexOptions.IgnoreCase | RegexOptions.Compiled)),
        ("V-CR-02/03/04 · inline pwd",
         new Regex(@"\bpwd\s*=\s*[^;""'\s]{3,}", RegexOptions.IgnoreCase | RegexOptions.Compiled)),
        ("V-CR-03 · config key PASSPHRASE/SFTPPassword/etc",
         new Regex(@"key\s*=\s*""(PASSPHRASE|SFTPPassword|SFTPPass|Password|Pwd|ApiSecret|SecretKey|AccessKey|Token|AuthToken)""\s+value\s*=\s*""[^""]{3,}""", RegexOptions.IgnoreCase | RegexOptions.Compiled)),
        ("V-HI-01 · ATOS5246 literal",
         new Regex(@"ATOS5246", RegexOptions.Compiled)),
    };

    // Allowed literals (placeholders in templates or configMaps without real secrets)
    private static readonly string[] AllowedPlaceholders =
    {
        "PLACEHOLDER",
        "REPLACE_ME",
        "xxxxxxxx",
        "{{",           // helm / envsubst templates
        "${",           // bash-style templates
    };

    [Fact(DisplayName = "V-CR-02/03/04 + V-HI-01 · no inline secrets in any source file")]
    public void NoInlineSecretsInAnySourceFile()
    {
        var root = FindRepoRoot();
        Assert.NotNull(root);

        var violations = Directory
            .EnumerateFiles(root!, "*", SearchOption.AllDirectories)
            .Where(p => SourceExtensions.Contains(Path.GetExtension(p).ToLower()))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "bin" + Path.DirectorySeparatorChar))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "obj" + Path.DirectorySeparatorChar))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "packages" + Path.DirectorySeparatorChar))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "tests" + Path.DirectorySeparatorChar))
            .SelectMany(CheckFile)
            .ToList();

        Assert.True(
            violations.Count == 0,
            $"Secret regression detected · {violations.Count} violation(s):\n" +
            string.Join("\n", violations.Take(20)) +
            "\n\nTodas las credenciales deben residir en AWS Secrets Manager · nunca inline en código/config.");
    }

    private static IEnumerable<string> CheckFile(string path)
    {
        string[] lines;
        try { lines = File.ReadAllLines(path); }
        catch { yield break; }

        for (int i = 0; i < lines.Length; i++)
        {
            var line = lines[i];

            if (AllowedPlaceholders.Any(p => line.Contains(p, StringComparison.OrdinalIgnoreCase)))
                continue;

            foreach (var (ruleId, pattern) in ForbiddenSecrets)
            {
                if (pattern.IsMatch(line))
                {
                    var shortLine = line.Length > 120 ? line.Substring(0, 120) + "..." : line;
                    yield return $"  [{ruleId}] {path}:{i + 1} → {shortLine.Trim()}";
                    break; // one violation per line is enough
                }
            }
        }
    }

    private static string? FindRepoRoot()
    {
        var dir = new DirectoryInfo(Directory.GetCurrentDirectory());
        while (dir != null)
        {
            if (File.Exists(Path.Combine(dir.FullName, "{{APP_NAME_PASCAL}}.sln")))
                return dir.FullName;
            dir = dir.Parent;
        }
        return null;
    }
}
