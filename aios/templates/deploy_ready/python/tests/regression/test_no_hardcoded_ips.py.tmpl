"""Regression test · {{APP_NAME}} · IPs hardcoded NO deben existir (resolver vía DNS interno)."""

import re
from pathlib import Path


SOURCE_EXTS = {".py", ".yaml", ".yml", ".json", ".cfg", ".ini"}
SKIP_DIRS = ("bin", "obj", "packages", ".vs", "node_modules", "__pycache__", ".venv", "venv", "tests")

# Placeholder IPs · ajustar según fase-1-discovery de cada app
LEGACY_IPS = []  # populated post-discovery · e.g. ["172.24.34.77"]

GENERIC_PRIVATE_IP = re.compile(
    r"\b(10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})\b"
)


def _find_repo_root() -> Path:
    p = Path(__file__).resolve()
    while p.parent != p:
        if (p / "pyproject.toml").exists():
            return p
        p = p.parent
    return Path(__file__).resolve().parents[3]


def test_no_specific_legacy_ips():
    if not LEGACY_IPS:
        return  # nothing to test if app has no known legacy IPs

    root = _find_repo_root()
    violations = []
    for path in root.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in SOURCE_EXTS:
            continue
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        try:
            lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
        except OSError:
            continue
        for i, line in enumerate(lines, start=1):
            for ip in LEGACY_IPS:
                if ip in line:
                    violations.append(f"{path}:{i} → {ip}")

    assert not violations, (
        f"Legacy IP regression · {len(violations)} hit(s):\n"
        + "\n".join(violations)
        + "\n\nUsar DNS internal (Route53 PHZ)."
    )


def test_no_generic_private_ips():
    """Warn-level test · private-range IPs suggest hardcoded infra."""
    root = _find_repo_root()
    violations = []
    for path in root.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in SOURCE_EXTS:
            continue
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        matches = GENERIC_PRIVATE_IP.findall(text)
        if matches:
            violations.extend(f"{path} → {m}" for m in matches[:3])

    # Soft: only fail if > 0 · adapt threshold per app
    assert len(violations) == 0, (
        f"{len(violations)} hardcoded private IP(s) detected · prefer DNS:\n"
        + "\n".join(violations[:10])
    )
