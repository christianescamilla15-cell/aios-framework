// Regression test · V-HI-03 · IPs hardcoded NO deben existir
// Las IPs de infraestructura deben resolverse vía DNS interno (Route53) post Gate 6

using System.IO;
using System.Linq;
using System.Text.RegularExpressions;
using Xunit;

namespace {{APP_NAME_PASCAL}}.Tests.Regression;

public class NoHardcodedIpsTest
{
    private static readonly string[] SourceExtensions = { ".cs", ".config", ".json", ".xml", ".yaml", ".yml" };

    // IPs específicas del legacy {{APP_NAME_SHORT}} (V-HI-03)
    private static readonly string[] ForbiddenIps =
    {
        "172.24.34.77",
        "172.18.60.227",
        "10.19.17.33",
    };

    [Fact(DisplayName = "V-HI-03 · no hardcoded legacy IPs (172.24.34.77 · 172.18.60.227 · 10.19.17.33)")]
    public void NoHardcodedLegacyIps()
    {
        var root = FindRepoRoot();
        Assert.NotNull(root);

        var violations = Directory
            .EnumerateFiles(root!, "*", SearchOption.AllDirectories)
            .Where(p => SourceExtensions.Contains(Path.GetExtension(p).ToLower()))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "bin" + Path.DirectorySeparatorChar))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "obj" + Path.DirectorySeparatorChar))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "packages" + Path.DirectorySeparatorChar))
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "tests" + Path.DirectorySeparatorChar))
            .SelectMany(CheckFile)
            .ToList();

        Assert.True(
            violations.Count == 0,
            $"V-HI-03 regression detected · {violations.Count} hardcoded IP reference(s):\n" +
            string.Join("\n", violations) +
            "\n\nUsar DNS internal (Route53 Private Hosted Zones) · coordinar con Diego Zarate.");
    }

    private static IEnumerable<string> CheckFile(string path)
    {
        string[] lines;
        try { lines = File.ReadAllLines(path); }
        catch { yield break; }

        for (int i = 0; i < lines.Length; i++)
        {
            foreach (var ip in ForbiddenIps)
            {
                if (lines[i].Contains(ip))
                {
                    yield return $"  {path}:{i + 1} → {ip}";
                    break;
                }
            }
        }
    }

    private static string? FindRepoRoot()
    {
        var dir = new DirectoryInfo(Directory.GetCurrentDirectory());
        while (dir != null)
        {
            if (File.Exists(Path.Combine(dir.FullName, "{{APP_NAME_PASCAL}}.sln")))
                return dir.FullName;
            dir = dir.Parent;
        }
        return null;
    }
}
